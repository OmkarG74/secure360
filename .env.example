# ==============================================================================
# SECURE360 CONFIGURATION
# ==============================================================================

# Application Environment (development / production)
APP_ENV=development
APP_DEBUG=true
APP_NAME=Secure360
APP_URL=http://localhost/Secure360

# Database Configuration (MySQL / XAMPP / WAMP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=secure360_v2
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# API & Security
JWT_SECRET=change_this_to_a_secure_random_key_in_production
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false

# Timezone & Locale
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

# Storage & Uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf,doc,docx

# Ola Maps / Krutrim Maps Platform
OLA_MAPS_API_KEY=
